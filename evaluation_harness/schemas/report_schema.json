{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Final investigation report",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "case_id",
  "conclusion",
  "classification",
  "confidence",
  "supporting_observations",
  "limitations",
  "unresolved_questions",
  "recommended_action",
  "evidence_references"
 ],
 "properties": {
  "case_id": {
   "type": "string",
   "minLength": 1
  },
  "conclusion": {
   "type": "string",
   "minLength": 1
  },
  "classification": {
   "type": "string",
   "enum": [
    "likely_fraud",
    "likely_legitimate",
    "indeterminate"
   ]
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1,
   "description": "Confidence in the final investigation conclusion based only on evidence available at case creation."
  },
  "supporting_observations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "observation",
     "evidence_references"
    ],
    "properties": {
     "observation": {
      "type": "string",
      "minLength": 1
     },
     "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "minLength": 1
      },
      "description": "Record identifiers only: the exact string value of an ID field from the evidence JSON, one per item. Only the few records that directly support the finding (at most 10). Never a run of consecutive identifiers.",
      "maxItems": 10
     }
    }
   }
  },
  "limitations": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "unresolved_questions": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "recommended_action": {
   "type": "string",
   "minLength": 1
  },
  "evidence_references": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   },
   "description": "Record identifiers only: the exact string value of an ID field from the evidence JSON, one per item. Only the few records that directly support the finding (at most 10). Never a run of consecutive identifiers.",
   "maxItems": 10
  }
 }
}