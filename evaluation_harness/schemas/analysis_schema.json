{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Evidence analysis",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "case_id",
  "findings",
  "suspicious_patterns",
  "contradictory_or_benign_factors",
  "confidence",
  "evidence_references"
 ],
 "properties": {
  "case_id": {
   "type": "string",
   "minLength": 1
  },
  "findings": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "finding",
     "classification",
     "evidence_references"
    ],
    "properties": {
     "finding": {
      "type": "string",
      "minLength": 1
     },
     "classification": {
      "type": "string",
      "enum": [
       "direct_fact",
       "interpretation",
       "uncertain"
      ]
     },
     "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "minLength": 1
      },
      "description": "Record identifiers only: the exact string value of an ID field from the evidence JSON, one per item. Only the few records that directly support the finding (at most 10). Never a run of consecutive identifiers.",
      "maxItems": 10
     }
    }
   }
  },
  "suspicious_patterns": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "contradictory_or_benign_factors": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1,
   "description": "Confidence in the investigation conclusion based only on evidence available at case creation."
  },
  "evidence_references": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   },
   "description": "Record identifiers only: the exact string value of an ID field from the evidence JSON, one per item. Only the few records that directly support the finding (at most 10). Never a run of consecutive identifiers.",
   "maxItems": 10
  }
 }
}